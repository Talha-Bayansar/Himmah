{
  "name": "himmah-futsal",
  "version": "0.1.0",
  "private": true,
  "description": "Himmah Hub engagement platform and connected youth games",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check": "npm run typecheck && npm run docs:check && npm test",
    "typecheck": "npm run i18n:compile && tsr generate && tsc --noEmit",
    "docs:check": "node scripts/check-docs.mjs",
    "dev": "vite --host 0.0.0.0 --port 3101",
    "build": "npm run pwa:assets && vite build",
    "start": "vite preview --host 0.0.0.0 --port 3101",
    "test": "npm run i18n:compile && npm run test:unit && npm run test:worker && npm run test:ui",
    "format": "prettier --write src tests vite.config.ts drizzle.config.ts",
    "deploy": "npm run build && wrangler deploy --config dist/server/wrangler.json",
    "db:generate": "drizzle-kit generate",
    "test:unit": "node --experimental-strip-types --test tests/*.test.ts",
    "test:ui": "npm run i18n:compile && vitest run",
    "i18n:compile": "node scripts/compile-i18n.mjs",
    "test:contrast": "node scripts/check-contrast.mjs",
    "pwa:assets": "node scripts/generate-pwa-assets.mjs",
    "test:worker": "node --test tests/worker-runtime.test.mjs"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@inlang/paraglide-js": "^2.29.0",
    "@inlang/plugin-message-format": "^4.5.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.167.45",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "miniflare": "^5.20261012.1-beta",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^5.9.2",
    "@neondatabase/auth": "^0.6.0-beta",
    "@neondatabase/serverless": "^1.2.0",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.4",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-start": "^1.169.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.59.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-resizable-panels": "^4.14.5",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.5.4"
  }
}
