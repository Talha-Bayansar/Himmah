{
  "name": "himmah-futsal",
  "version": "0.1.0",
  "private": true,
  "description": "Himmah Hub engagement platform and connected youth games",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check": "npm run typecheck && npm run docs:check && npm test",
    "typecheck": "next typegen && tsc --noEmit",
    "docs:check": "node scripts/check-docs.mjs",
    "dev": "next dev --hostname 0.0.0.0 --port 3101",
    "build": "next build",
    "start": "wrangler dev --ip 0.0.0.0 --port 3101",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "format": "prettier --write src tests next.config.ts",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "wrangler": "^4.151.1"
  },
  "dependencies": {
    "lucide-react": "^1.59.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
