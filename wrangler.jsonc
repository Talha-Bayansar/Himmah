{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "himmah-hub",
  "main": "src/server.ts",
  "vars": {
    "HIMMAH_PEOPLE_ENABLED": "true",
    "HIMMAH_MAINTENANCE": "false",
    "HIMMAH_APP_ORIGIN": "https://himmah-hub.talha-bayansar.workers.dev",
    "HIMMAH_AUTH_URL": "https://ep-broad-sea-b9dnqx7c.neonauth.c-7.eu-central-1.aws.neon.tech/himmah_futsal/auth"
  },
  "compatibility_flags": ["nodejs_compat"],
  "compatibility_date": "2026-10-18",
  "workers_dev": true,
  "triggers": { "crons": ["* * * * *"] },
  "ratelimits": [{ "name": "ONBOARDING_LIMITER", "namespace_id": "2847131", "simple": { "limit": 10, "period": 60 } },{ "name": "DIRECTORY_LIMITER", "namespace_id": "693875421", "simple": { "limit": 60, "period": 60 } }],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
